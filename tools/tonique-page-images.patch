+/// The hero's video: the loop played twice, the second time saved as
+/// `hero-frames/0000.png`... (it loops seamlessly into its start), the
+/// first frame also as `hero.png`, the video's poster.
+fn record_hero(harness: &mut Harness<'_, ToniqueApp>, processor: &mut AudioProcessor) {
+    let dir = images_dir().join("hero-frames");
+    std::fs::create_dir_all(&dir).unwrap();
+    play(harness, processor, LOOP_FROM, 2 * LOOP_FRAMES, |harness, f| {
+        if f <= LOOP_FRAMES {
+            return;
+        }
+        let index = f - LOOP_FRAMES - 1;
+        let image = harness.render().expect("the app renders");
+        image.save(dir.join(format!("{index:04}.png"))).unwrap();
+        if index == 0 {
+            image.save(images_dir().join("hero.png")).unwrap();
+        }
+    });
+    eprintln!("Wrote {LOOP_FRAMES} frames to {}", dir.display());
 }
 
