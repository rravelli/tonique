+
+/// Plays from `from` for `frames` frames of the video, each its share of
+/// audio rendered and then the app stepped once, the meters timed by the
+/// audio: the same on every run, however long drawing takes. Calls `frame`
+/// with each one's number, from 1.
+fn play(
+    harness: &mut Harness<'_, ToniqueApp>,
+    processor: &mut AudioProcessor,
+    from: BeatPos,
+    frames: usize,
+    mut frame: impl FnMut(&mut Harness<'_, ToniqueApp>, usize),
+) {
+    harness.event(Event::PointerGone);
+    // Stopped a moment first, rendering: the engine takes up the graph its
+    // threads built, or the first blocks played would depend on when.
+    for _ in 0..WARM_UP_STEPS {
+        render_offline(processor, BUFFER, 2);
+        harness.run_steps(1);
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    let app = harness.state_mut();
+    app.state.seek(from);
+    app.state.play();
+    let mut rendered = 0;
+    for f in 1..=frames {
+        // In whole device buffers, as an output asks for them.
+        let due = (f as f64 / FPS * SAMPLE_RATE) as usize / BUFFER * BUFFER;
+        render_offline(processor, due - rendered, 2);
+        FIXED_DT.set(Some((due - rendered) as f32 / SAMPLE_RATE as f32));
+        rendered = due;
+        harness.run_steps(1);
+        frame(harness, f);
+    }
+    FIXED_DT.set(None);
+}
